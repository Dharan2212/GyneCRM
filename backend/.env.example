# ──────────────────────────────────────────────────────────────────────────────
# GyneCRM Backend — Environment Configuration
# Copy this file to .env and fill in real values before starting.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=GyneCRM
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL 16)
# ──────────────────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gynecrm
DB_USER=postgres
DB_PASSWORD=Dharan47@dh
DB_NAME_TEST=gynecrm_test
DB_POOL_MIN=2
DB_POOL_MAX=10

# ──────────────────────────────────────────────────────────────────────────────
# JWT  (each secret must be at least 64 characters, cryptographically random)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64char_minimum_random_secret_for_access_tokens_here_abcdef123456
JWT_REFRESH_SECRET=replace_with_64char_minimum_random_secret_for_refresh_tokens_xyz789abcdef
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────────────────────────────────────
# COOKIES
# ──────────────────────────────────────────────────────────────────────────────
COOKIE_SECURE=false

# ──────────────────────────────────────────────────────────────────────────────
# CORS  — comma-separated list of allowed frontend origins
# IMPORTANT: use ALLOWED_ORIGINS (not CORS_ORIGINS)
# ──────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ──────────────────────────────────────────────────────────────────────────────
# AWS S3 / OBJECT STORAGE
# Leave empty for local development — S3 operations will fail gracefully
# without crashing the server.
# ──────────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: set for local MinIO or S3-compatible storage
S3_ENDPOINT=
S3_UPLOAD_URL_EXPIRY_SECONDS=900
S3_DOWNLOAD_URL_EXPIRY_SECONDS=1800
MAX_FILE_SIZE_MB=20

# ──────────────────────────────────────────────────────────────────────────────
# N8N AUTOMATION
# Leave empty for local development — automation events will be logged
# as pending/failed but will not crash the API.
# ──────────────────────────────────────────────────────────────────────────────
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# ACCOUNT LOCKOUT
# ──────────────────────────────────────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
