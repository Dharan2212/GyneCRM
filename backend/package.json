{
  "name": "gynecrm-backend",
  "version": "1.0.0",
  "description": "GyneCRM Hospital CRM & Automation System - Backend API",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPattern=src/tests/unit --runInBand --forceExit",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPattern=src/tests/integration --runInBand --forceExit",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand --forceExit",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "migrate": "knex --knexfile src/db/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile src/db/knexfile.js migrate:rollback",
    "migrate:test": "cross-env NODE_ENV=test knex --knexfile src/db/knexfile.js migrate:latest",
    "seed": "knex --knexfile src/db/knexfile.js seed:run",
    "seed:test": "cross-env NODE_ENV=test knex --knexfile src/db/knexfile.js seed:run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.1",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/jest.setup.js"
    ],
    "testMatch": [
      "**/src/tests/unit/**/*.test.js",
      "**/src/tests/integration/**/*.test.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**",
      "!src/db/migrations/**",
      "!src/db/seeds/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "verbose": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED"
}
