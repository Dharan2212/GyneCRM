# =============================================================
# GyneCRM Backend — Test Environment Configuration
# =============================================================
# Used exclusively when NODE_ENV=test
# Maps directly to src/config/env.js variable structure
# =============================================================

NODE_ENV=test

# ── Database (Test DB) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gynecrm
DB_NAME_TEST=gynecrm_test
DB_USER=postgres
DB_PASSWORD=postgres

# ── JWT Secrets ───────────────────────────────────────────────
# Variable names must match env.js exactly:
#   JWT_SECRET        → access token signing secret
#   JWT_REFRESH_SECRET → refresh token signing secret (stateless JWT, httpOnly cookie)
JWT_SECRET=test-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-min-32-characters-long

# ── JWT Expiry ────────────────────────────────────────────────
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────────
PORT=4001
APP_NAME=GyneCRM-Test
LOG_LEVEL=error

# ── Rate Limiting (relaxed for tests) ────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# =============================================================
# NOTE: DATABASE_URL is NOT used in this project.
# NOTE: JWT_ACCESS_SECRET is NOT used — use JWT_SECRET only.
# =============================================================
