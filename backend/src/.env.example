# ─────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=GyneCRM

# ─────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gynecrm_db
DB_USER=gynecrm_user
DB_PASSWORD=Dharan47@dh
DB_POOL_MIN=2
DB_POOL_MAX=10
# Optional: separate database name for tests (defaults to DB_NAME_test)
DB_NAME_TEST=gynecrm_db_test

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
# Access token secret — minimum 64 chars, cryptographically random
JWT_SECRET=replace_with_64_char_minimum_random_secret_for_access_tokens
# Refresh token secret — separate secret, minimum 64 chars
JWT_REFRESH_SECRET=replace_with_64_char_minimum_random_secret_for_refresh_tokens
# Access token TTL in seconds — default 900 = 15 minutes
JWT_ACCESS_TTL_SECONDS=900
# Refresh token TTL in seconds — default 604800 = 7 days
JWT_REFRESH_TTL_SECONDS=604800

# ─────────────────────────────────────────────────────────────
# COOKIES
# ─────────────────────────────────────────────────────────────
COOKIE_SECRET=replace_with_32_char_minimum_random_cookie_signing_secret
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
# Auth routes — tighter limit
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ─────────────────────────────────────────────────────────────
# AWS S3 / OBJECT STORAGE
# ─────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=gynecrm-uploads
# Pre-signed PUT URL TTL for client-side direct upload — 15 minutes
S3_UPLOAD_URL_EXPIRY_SECONDS=900
# Pre-signed GET URL TTL for file download/view — 30 minutes
S3_DOWNLOAD_URL_EXPIRY_SECONDS=1800
# Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=20
# Optional: custom endpoint for local MinIO or S3-compatible storage
# S3_ENDPOINT=http://localhost:9000

# ─────────────────────────────────────────────────────────────
# N8N AUTOMATION
# ─────────────────────────────────────────────────────────────
# N8N_BASE_URL: The base URL of your N8N instance.
#   Development:  http://localhost:5678
#   Production:   https://n8n.yourdomain.com  (HTTPS required in production)
N8N_BASE_URL=http://localhost:5678

# N8N_WEBHOOK_SECRET: Shared secret between GyneCRM backend and N8N.
#   - Used to verify that callbacks to /api/v1/webhooks/n8n-callback
#     originate from your N8N instance and not from external actors.
#   - Must be the SAME value configured in N8N as the webhook header secret.
#   - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   - Minimum 32 characters, cryptographically random.
#   - NEVER commit the real value to version control.
N8N_WEBHOOK_SECRET=replace_with_strong_random_webhook_secret_min_32_chars

# ─────────────────────────────────────────────────────────────
# N8N WORKFLOW READINESS NOTES
# ─────────────────────────────────────────────────────────────
# Before going live, ensure the following are configured in N8N:
#
#   Workflow 1:  appointment_confirmation    → Trigger: APPOINTMENT_CREATED
#   Workflow 2:  reminder_24h               → Trigger: APPOINTMENT_REMINDER_24H
#   Workflow 3:  reminder_2h                → Trigger: APPOINTMENT_REMINDER_2H
#   Workflow 4:  missed_appointment_recovery → Trigger: APPOINTMENT_MISSED
#   Workflow 5:  pregnancy_milestone        → Trigger: PREGNANCY_MILESTONE_REACHED
#   Workflow 6:  followup_reminder          → Trigger: FOLLOWUP_DUE
#   Workflow 7:  test_reminder              → Trigger: TEST_ORDER_CREATED
#   Workflow 8:  pregnancy_weekly_tips      → Trigger: PREGNANCY_WEEKLY_TIPS
#   Workflow 9:  feedback_collection        → Trigger: FEEDBACK_REQUESTED
#
# All workflows must:
#   - Accept POST at /webhook/{event-slug}  (e.g. /webhook/appointment-created)
#   - Validate the X-Webhook-Secret header
#   - Validate event_version field in the envelope
#   - Call POST /api/v1/webhooks/n8n-callback after delivery
#
# Use GET /api/v1/notifications/automation-status (admin JWT required)
# to verify backend automation readiness before going live.

# ─────────────────────────────────────────────────────────────
# ACCOUNT LOCKOUT
# ─────────────────────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ─────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# SENTRY (production error tracking)
# ─────────────────────────────────────────────────────────────
# SENTRY_DSN=https://your_sentry_dsn_here
