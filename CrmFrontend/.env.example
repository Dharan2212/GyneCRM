# GyneCRM frontend release environment example
# Copy to .env.local for local work or provide equivalent vars in your host panel.

# Optional label shown in diagnostics/docs only
VITE_APP_ENV=development

# Local development default backend API base URL
# In production, set this explicitly if frontend and backend are on different origins.
# If omitted in production, the frontend assumes the API is available on the SAME origin at /api/v1.
VITE_API_BASE_URL=http://localhost:8082/api/v1

# Request timeout for API calls in milliseconds
VITE_API_TIMEOUT_MS=20000

# Must remain "include" while refresh is managed by an httpOnly cookie.
# Change only if the backend auth/session model changes.
VITE_API_CREDENTIALS_MODE=include

# Optional Vite local dev/preview settings
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
VITE_PREVIEW_HOST=0.0.0.0
VITE_PREVIEW_PORT=4173

# Optional build diagnostics
VITE_BUILD_SOURCEMAP=false
